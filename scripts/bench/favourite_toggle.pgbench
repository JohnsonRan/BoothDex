-- Adding and removing a favourite (account.rs add_favourite, remove_favourite), each counted in item_stats by the
-- count_favourite trigger. Popular items take most clicks, so concurrent clients contend for their rows.
\set uid random(1, 20000)
\set iid random_zipfian(1, 200000, 1.1)
insert into favourites (user_id, item_id) values (:uid, :iid) on conflict do nothing;
delete from favourites where user_id = :uid and item_id = :iid;
