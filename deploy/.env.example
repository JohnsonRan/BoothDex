# Copy to deploy/.env and fill in. Never commit the filled-in file.

# Public hostname (Caddy requests the TLS certificate for it) and the full site URL (used in RSS links)
SITE_DOMAIN=catalogue.example.com
SITE_URL=https://catalogue.example.com

# Long random password, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Comma-separated usernames that get the admin console. Register the account on the site first.
ADMIN_USERNAMES=

# Host directory holding the archived <sha1>.webp images of delisted items (from the data bundle)
ARCHIVE_IMAGES_DIR=/srv/catalogue/images

# Image cache sizes (transcoded WebP); disk cache lives in the imgcache volume
IMG_CACHE_DISK_MB=10240
IMG_CACHE_MEM_MB=256
