# Copy to deploy/.env and fill in. Never commit the filled-in file.

# Image version from ghcr.io: latest (follows master), a release such as 0.1.0, or sha-<commit>
BOOTHDEX_TAG=latest

# Where the site listens on the host: "port" (all interfaces) or "address:port", e.g. 127.0.0.1:3100 when a
# reverse proxy on this host is the only client. No other service publishes a port.
WEB_LISTEN=3100

# Public HTTP(S) origin, without a path (used in RSS links, canonical URLs, robots.txt and sitemap.xml)
SITE_URL=https://boothdex.example.com

# Who runs this site, as named in the privacy policy and terms (/privacy, /terms); defaults to the SITE_URL host.
# CONTACT_EMAIL is where visitors and BOOTH creators send data, deletion and takedown requests.
OPERATOR_NAME=
CONTACT_EMAIL=

# Session cookies are sent over HTTPS only (1). Set 0 only for testing over plain http://, or sign-in won't stick.
COOKIE_SECURE=1

# Long random password, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Comma-separated usernames that get the admin console. Register the account on the site first.
ADMIN_USERNAMES=

# Host directory holding the archived <sha1>.webp images of delisted items (e.g. /srv/boothdex/images from the data
# bundle). Leave empty when starting without a data bundle.
ARCHIVE_IMAGES_DIR=

# Image cache sizes (transcoded AVIF); disk cache lives in the imgcache volume
IMG_CACHE_DISK_MB=10240
IMG_CACHE_MEM_MB=256

# Optional AI provider (OpenAI-compatible). When set, these win over the admin console and lock those fields there,
# so the key never touches the database. Leave empty to configure it in the admin console instead.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# none (default), minimal, low, medium, high or xhigh; sent to the provider as reasoning_effort
AI_REASONING_EFFORT=
# Embeddings model for semantic search (same address and key as above); must support 1024-dimension output.
# Leave empty for word search only. Changing it re-embeds every item.
AI_EMBED_MODEL=
